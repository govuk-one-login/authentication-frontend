{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.17.0/schemas/schema.json",
  "services": [
    {
      "product": "Authentication",
      "component": "authentication-frontend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "checkTypes": ["code style and linting"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/pre-commit.yml",
          "path": "$.jobs.pre-commit"
        },
        {
          "checkTypes": ["vulnerability detection"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/dependency-review.yml",
          "path": "$.jobs.dependency-review"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration",
              "purpose": ["new feature", "regression"]
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-tests.steps[?@.name=='Run integration tests']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-tests.steps[?@.name=='Run lint']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-tests.steps[?@.name=='SonarCloud Scan']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": ["new feature", "regression"]
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-tests.steps[?@.name=='Run unit tests']"
        },
        {
          "checkTypes": ["visual regression"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "visual regression"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.snapshot-tests"
        },
        {
          "checkTypes": ["code style and linting", "code quality"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/checkov.yml",
          "path": "$.jobs.scan"
        },
        {
          "checkTypes": ["code style and linting"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/dependabot-validate.yml",
          "path": "$.jobs.validate"
        },
        {
          "checkTypes": ["code style and linting", "code quality"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/pre-merge-checks-shellscript.yaml",
          "path": "$.jobs.shellcheck"
        },
        {
          "checkTypes": ["code style and linting", "code quality"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/require-pinned-github-actions.yml",
          "path": "$.jobs.check-actions-sha"
        }
      ]
    }
  ]
}
